{%- comment -%}
  breadcrumbs.liquid
  Visible breadcrumb trail + matching BreadcrumbList JSON-LD, for on-page SEO.
  Rendered near the top of <main> on every template except the homepage.
  Trail by page type: Home / [Collection] / Product, Home / Collection,
  Home / Blog / Article, Home / Page, Home / Search, Home / [title].
{%- endcomment -%}
{%- unless request.page_type == 'index' or request.page_type == 'cart' or request.page_type == 'password' -%}
  {% style %}
    .breadcrumb { padding: 1rem 0; font-size: 1.3rem; }
    .breadcrumb__list { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin: 0; padding: 0; }
    .breadcrumb__item { display: inline-flex; align-items: center; color: rgba(var(--color-foreground), 0.62); }
    .breadcrumb__item + .breadcrumb__item::before { content: "/"; margin: 0 0.55rem 0 0.15rem; color: rgba(var(--color-foreground), 0.4); }
    .breadcrumb__item a { color: rgba(var(--color-foreground), 0.62); text-decoration: none; }
    .breadcrumb__item a:hover { color: rgb(225, 27, 34); text-decoration: underline; }
    .breadcrumb__item[aria-current="page"] { color: rgb(var(--color-foreground)); font-weight: 600; }
  {% endstyle %}

  <nav class="breadcrumb page-width" aria-label="Breadcrumb" role="navigation">
    <ol class="breadcrumb__list">
      <li class="breadcrumb__item"><a href="{{ routes.root_url }}">Home</a></li>
      {%- case request.page_type -%}
        {%- when 'product' -%}
          {%- if collection.url -%}
            <li class="breadcrumb__item"><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
          {%- endif -%}
          <li class="breadcrumb__item" aria-current="page">{{ product.title | escape }}</li>
        {%- when 'collection' -%}
          <li class="breadcrumb__item" aria-current="page">{{ collection.title | escape }}</li>
        {%- when 'blog' -%}
          <li class="breadcrumb__item" aria-current="page">{{ blog.title | escape }}</li>
        {%- when 'article' -%}
          <li class="breadcrumb__item"><a href="{{ blog.url }}">{{ blog.title | escape }}</a></li>
          <li class="breadcrumb__item" aria-current="page">{{ article.title | escape }}</li>
        {%- when 'page' -%}
          <li class="breadcrumb__item" aria-current="page">{{ page.title | escape }}</li>
        {%- when 'search' -%}
          <li class="breadcrumb__item" aria-current="page">Search</li>
        {%- else -%}
          <li class="breadcrumb__item" aria-current="page">{{ page_title | default: page.title | escape }}</li>
      {%- endcase -%}
    </ol>
  </nav>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: routes.root_url | json }} }
      {%- case request.page_type -%}
        {%- when 'product' -%}
          {%- if collection.url -%}
            ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
            ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }
          {%- else -%}
            ,{ "@type": "ListItem", "position": 2, "name": {{ product.title | json }} }
          {%- endif -%}
        {%- when 'collection' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }} }
        {%- when 'blog' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }} }
        {%- when 'article' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} }
          ,{ "@type": "ListItem", "position": 3, "name": {{ article.title | json }} }
        {%- when 'page' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ page.title | json }} }
        {%- when 'search' -%}
          ,{ "@type": "ListItem", "position": 2, "name": "Search" }
        {%- else -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ page_title | default: page.title | json }} }
      {%- endcase -%}
    ]
  }
  </script>
{%- endunless -%}
